# Django core
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Keep the production database outside the source checkout when possible.
DJANGO_DB_PATH=C:/promotion-calculator-data/db.sqlite3

# HTTPS / reverse proxy
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_USE_X_FORWARDED_PROTO=1
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# Legal documents (required before production publication)
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT=

# User action audit log. Enable only after retention and server permissions are confirmed.
PROMOCALC_ENV=production
USER_ACTION_LOG_ENABLED=0
USER_ACTION_LOG_DIR=C:/caddy/logs/AuditLog/promotion-calculator
USER_ACTION_LOG_RETENTION_MONTHS=3
TRUST_DIRECT_CLIENT_IP=0
